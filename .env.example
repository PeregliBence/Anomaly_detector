# Anomaly Detector Configuration
# Copy this file to .env and customize as needed.

# ---- Data ----
DEFAULT_TICKER=AAPL
DEFAULT_START_DATE=2018-01-01
DEFAULT_LOOKBACK_YEARS=6

# ---- Anomaly Detection ----
ZSCORE_THRESHOLD=3.0
ZSCORE_METHOD=rolling
ZSCORE_WINDOW=60
IF_CONTAMINATION=0.01
IF_N_ESTIMATORS=200
IF_ENSEMBLE_RUNS=5
LOF_CONTAMINATION=0.01
LOF_N_NEIGHBORS=20
OCSVM_NU=0.01

# ---- LSTM Autoencoder ----
LSTM_SEQ_LEN=30
LSTM_EPOCHS=7
LSTM_BATCH_SIZE=64
LSTM_LATENT_DIM=32
LSTM_THRESH_METHOD=median_mad
LSTM_MAD_MULT=3.0

# ---- Forecasting ----
FORECAST_HORIZON=5
ARIMA_MAX_P=5
ARIMA_MAX_Q=5
XGBOOST_N_ESTIMATORS=200
LSTM_FORECAST_EPOCHS=20

# ---- Ensemble ----
ENSEMBLE_VOTE_K=2
ENSEMBLE_COMBINE=and

# ---- Live Mode ----
LIVE_REFRESH_SECONDS=300

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Alternative Data APIs ----
# FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Google Gemini (free tier generous): https://aistudio.google.com/app/apikey
# Used for LLM sentiment analysis and explanations
GEMINI_API_KEY=

# Optional news provider keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=
BENZINGA_API_KEY=

# ---- Alternative Data Toggles ----
ENABLE_FRED=true
ENABLE_FEAR_GREED=true
ENABLE_OPTIONS_DATA=true
ENABLE_SHORT_INTEREST=true
ENABLE_LLM_SENTIMENT=true

# ---- Advanced Forecasting ----
ENABLE_GARCH=true
ENABLE_STACKING=true
ENABLE_TFT=false
ENABLE_ONLINE_LEARNING=true
ENABLE_BACKTESTING=true
ENABLE_SHAP=true

# ---- Backtesting ----
BACKTEST_WINDOW_SIZE=252
BACKTEST_STEP_SIZE=20
