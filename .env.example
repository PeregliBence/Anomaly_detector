# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Sharadar direct API key, from https://sharadar.com/account.
# Only needed while exporting the snapshot (scripts/sharadar_export.py).
SHARADAR_API_KEY=

# FRED, for the credit-spread market features. Needed for training and for
# the daily run; on GitHub add it as an Actions secret of the same name.
FRED_API_KEY=
